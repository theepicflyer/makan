# Public URL makan is served on (Caddy terminates TLS). Used for OAuth callbacks and the MCP issuer.
PUBLIC_URL=https://makan.example.com
# Signs the login cookie. Leave empty to have one generated on first start and kept in the data volume.
SESSION_SECRET=

# Pocket ID OIDC client. Register both callback URLs on the one client:
#   https://makan.example.com/auth/web/callback   (browser login)
#   https://makan.example.com/auth/callback       (MCP connector OAuth)
OIDC_CONFIG_URL=https://auth.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional extra allowlist on top of Pocket ID's allowed groups (comma-separated emails).
ALLOWED_EMAILS=

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
AGENT_EFFORT=low

TIMEZONE=Asia/Singapore
# Local development only. Never enable on the server.
DEV_LOGIN=false

# Public URL Bao is served on (Caddy terminates TLS). Used for OAuth callbacks and the MCP issuer.
PUBLIC_URL=https://bao.example.com

# Pocket ID OIDC client: the issuer's address, without /.well-known. Register both callback URLs
# on the one client:
#   https://bao.example.com/auth/web/callback   (browser login)
#   https://bao.example.com/oauth/callback      (MCP connector OAuth)
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional extra allowlist on top of Pocket ID's allowed groups (comma-separated emails).
ALLOWED_EMAILS=
# Space-separated callbacks an MCP client may register ("*" matches within the pattern). Empty
# uses the default: claude.ai, claude.com, Meta Muse, http://localhost:*, http://127.0.0.1:*.
MCP_ALLOWED_REDIRECT_URIS=

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
AGENT_EFFORT=low

TIMEZONE=Asia/Singapore
# Local hour of the daily database snapshot written to /data/backup (see README, Backups).
SNAPSHOT_HOUR=3
# Daily reminders are Web Push notifications; the server needs outbound HTTPS to the push services
# (Google, Apple, Mozilla). Optional: who those services can contact, a mailto: address or a bare
# https:// host. Defaults to PUBLIC_URL's host.
VAPID_SUBJECT=
# Local development only. Never enable on the server.
DEV_LOGIN=false
